# Hugging Face Spaces Environment Configuration
# This file contains environment variables optimized for HF Spaces deployment

# Server Configuration
PORT=7860
HOST=0.0.0.0
NODE_ENV=production

# Request Timeouts (increased for HF Spaces reliability)
REQUEST_TIMEOUT=120000
INIT_TIMEOUT=300000

# Hugging Face Spaces specific
HF_SPACE=1
BASE_PATH=""

# Database Configuration (optional for HF Spaces)
# Enable if you need persistent storage
# DATABASE_URL=postgresql://user:pass@localhost:5432/mcphub
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DB=mcphub
# POSTGRES_USER=user
# POSTGRES_PASSWORD=password

# Smart Routing Configuration (optional)
# OPENAI_API_KEY=your_openai_api_key_here
# ENABLE_SMART_ROUTING=false

# Admin User Configuration
# Set these to override default admin credentials
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=admin123

# External API Keys (configure as needed)
# AMAP_MAPS_API_KEY=your_amap_api_key
# SLACK_BOT_TOKEN=your_slack_bot_token
# SLACK_TEAM_ID=your_slack_team_id
# GITHUB_PERSONAL_ACCESS_TOKEN=your_github_token
# TAVILY_API_KEY=your_tavily_api_key

# Performance Tuning for HF Spaces
NODE_OPTIONS="--max-old-space-size=1024"
UV_CACHE_DIR=/tmp/uv-cache
PNPM_CACHE_DIR=/tmp/pnpm-cache